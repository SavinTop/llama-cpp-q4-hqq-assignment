#version 450

#include "dequant_head.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {block_q4_hqq data_a[];};
layout (binding = 1) writeonly buffer D {D_TYPE data_b[];};

bool is_q4_hqq_zero_sentinel(uint ib) {
    if (floatBitsToUint(float(data_a[ib].scale)) != 0u ||
        floatBitsToUint(float(data_a[ib].zero)) != 0u) {
        return false;
    }
    uint qs = 0;
    [[unroll]] for (uint l = 0; l < 16; ++l) {
        qs |= uint(data_a[ib].qs[l]);
    }
    return qs == 0;
}

void main() {
    const uint i = gl_WorkGroupID.x * 4 + gl_LocalInvocationID.x / 64;

    const uint tid = gl_LocalInvocationID.x % 64;
    const uint il  = tid/32;
    const uint ir  = tid%32;
    const uint ib = 32*i + ir;
    if (ib >= p.nel / 32) {
        return;
    }

    const uint q_idx = 8*il;
    const uint b_idx = 1024*i + 32*ir + q_idx;

    const float scale = float(data_a[ib].scale);
    if (is_q4_hqq_zero_sentinel(ib) || !(scale > 0.0f) || isinf(scale) || isnan(scale)) {
        [[unroll]] for (uint l = 0; l < 8; ++l) {
            data_b[b_idx + l +  0] = D_TYPE(0.0f);
            data_b[b_idx + l + 16] = D_TYPE(0.0f);
        }
        return;
    }
    const float zero  = float(data_a[ib].zero);
    const float inv_scale = 1.0f / scale;

    [[unroll]] for (uint l = 0; l < 8; ++l) {
        const float v0 = (float(data_a[ib].qs[q_idx + l] & 0xF) - zero) * inv_scale;
        const float v1 = (float(data_a[ib].qs[q_idx + l] >>  4) - zero) * inv_scale;
        data_b[b_idx + l +  0] = D_TYPE(v0);
        data_b[b_idx + l + 16] = D_TYPE(v1);
    }
}
